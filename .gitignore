.DS_Store

# Backend source is part of the application; keep only runtime data private.
img-management-system/node_modules/
img-management-system/uploads/
img-management-system/data/
img-management-system/.env
img-management-system/.env.*
!img-management-system/.env.example
uploads/
node_modules/

# Secrets and environment files
.env
.env.*
!.env.example

# Logs and temporary files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Backend-only and legacy public entry points are not part of GitHub Pages.
admin.html

# The local backend owns source uploads. `npm run site:build` copies only images
# referenced by site-data.js into the tracked docs/ release directory.
images/**

# Static build scratch directories are disposable; docs/ itself is publishable.
.docs-build-*/
