PORT=3000
HOST=127.0.0.1
ALLOW_LAN_ACCESS=false
ALLOW_REGISTRATION=false
NODE_ENV=development

# 本地 MongoDB；仅完整后端上线时替换为远程数据库地址
MONGODB_URI=mongodb://127.0.0.1:27017/xiaofart

# 请分别生成随机值；JWT_SECRET 在生产环境至少 32 位
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_EXPIRES_IN=7d
ANALYTICS_SALT=replace_with_a_different_random_secret

# 首次启动时创建或更新唯一管理员；密码建议至少 12 位
ADMIN_NAME=管理员
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_unique_strong_password

CORS_ORIGIN=http://localhost:3000
